# DB principal del servicio AI (elige una opción: DATABASE_URL o DB_*)
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=tourism_ai
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=

# DB local de memoria AI
AI_SQLITE_PATH=./data/ai_memory.db

# IA local (chat/embeddings)
OLLAMA_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=mistral:7b-instruct
# Segundos para lectura en POST /api/chat hacia Ollama (CPU frío: carga modelo + inferencia).
OLLAMA_HTTP_TIMEOUT_SECONDS=300
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Docker Compose (EC2 / dos contenedores: ollama + ai). En Compose la app ya usa OLLAMA_URL interno;
# aquí solo variables que lee el YAML o el entrypoint vía `environment:`.
# OLLAMA_PULL_ON_START=1  # primera vez en Docker: descarga LOCAL_MODEL_NAME al arrancar (lento; compose demo lo activa por defecto).
# AI_HOST_PORT=8000       # puerto publicado en el host para FastAPI
