[run]
source = app
relative_files = true
branch = true
omit =
    app/__init__.py
    app/ml/model_loader.py
    app/modules/adaptive_ui/service.py
    app/modules/recommendations/service.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if TYPE_CHECKING:
    if __name__ == .__main__.:
fail_under = 90
show_missing = true
precision = 1
