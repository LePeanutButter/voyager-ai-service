    {
      "name": "07 — Travel preferences (cuestionario)",
      "item": [
        {
          "name": "Step 1 — nueva sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/travel-preferences/questionnaire/step",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"postman-prefs\",\n  \"answers\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  const j = pm.response.json();",
                  "  if (pm.response.code === 200 && j.session_id) {",
                  "    pm.environment.set('questionnaireSessionId', j.session_id);",
                  "    pm.collectionVariables.set('questionnaireSessionId', j.session_id);",
                  "  }",
                  "} catch (e) {}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Step 2 — estilo principal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/travel-preferences/questionnaire/step",
            "description": "Ejecutar después del step 1 (session_id en entorno).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"postman-prefs\",\n  \"session_id\": \"{{questionnaireSessionId}}\",\n  \"answers\": [\n    {\n      \"question_id\": \"primary_travel_style\",\n      \"selected_option_ids\": [\n        \"cultural\"\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Submit (requiere cuestionario completo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/travel-preferences/questionnaire/submit",
            "description": "Solo tras completar todos los pasos del motor adaptativo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"postman-prefs\",\n  \"session_id\": \"{{questionnaireSessionId}}\",\n  \"answers\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
