    {
      "key": "questionnaireSessionId",
      "value": ""
    },
    {
      "key": "seasonalityDestinationId",
      "value": "dst_lisbon"
    },
    {
      "key": "seasonalityTravelMonth",
      "value": "7"
    }
  ],
